# Copy this file to .env and fill in real values.
# The app FAILS AT STARTUP if required vars are missing.

# --- Database ---
DATABASE_URL=postgresql+psycopg2://ev_user:ev_pass@localhost:5432/ev_battery

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- App ---
APP_NAME=EV Battery Intelligence Platform
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# --- Model storage ---
MODEL_DIR=models
